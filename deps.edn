{:paths ["src"]
 :deps {io.github.kotoba-lang/langgraph
        {:git/sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}}
 :aliases
 {
  ;; clj-kondo from deps (no binary), errors fail CI. Added because this repo
  ;; could not be linted at all -- across this fleet an absent or broken :lint
  ;; alias is what let misplaced docstrings, dead code and even a false-green
  ;; test verdict survive unreported (cloud-itonami-isic-561/563/920).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}
  ;; run_tests.kotoba, not cognitect.test-runner. The 2026-09-10 rename moved
  ;; every source and test to .kotoba, which clojure.tools.namespace does not
  ;; resolve -- cognitect.test-runner then found nothing, ran nothing and
  ;; exited 0. `kbb -M <path>` loads by reader and ignores the extension,
  ;; so the runner stays inside the rename. It refuses (exit 2) rather than
  ;; report a pass when the run comes in under what README.md publishes.
  :test {:extra-paths ["test"]
         :main-opts ["run_tests.kotoba"]}}}

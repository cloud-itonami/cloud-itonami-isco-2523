(ns netops.run-tests
  "Load this actor's .kotoba sources and run its clojure.test suite,
  refusing to report a pass on a run that came in under what the
  README publishes.

  ## Why this file exists

  On 2026-09-10 an owner-instructed rename moved every .clj/.cljc
  source and test in this repository to .kotoba (8dfad97). The rename
  is deliberate and is not reverted here. What it also did, silently,
  was disconnect the suite: deps.edn ran cognitect.test-runner, and
  clojure.tools.namespace resolves only .clj/.cljc. Measured on
  2aa259b:

      $ kbb -M:test
      Ran 0 tests containing 0 assertions.
      0 failures, 0 errors.                       # exit 0

  The README claimed -- correctly, as it turns out -- '14 tests / 29
  assertions green'. Those 14 tests had not run since the rename, and
  nothing reported it, because a suite that ran nothing returns the
  same value as a suite that ran everything and found no fault
  (CLAUDE.md, ADR-2608136000, question 2). The tests were never
  broken. The runner had stopped being able to see them.

  ## Why the runner is .kotoba and not .clj

  A loader for .kotoba cannot itself be .kotoba if it must be loaded
  by name -- but it need not be. `kbb -M <path>` hands the file to
  Compiler.load(Reader), which never consults the extension. Only
  `require`/`load` do. So the bootstrap stays inside the rename.

  Two details are load-bearing, both learned from
  cloud-itonami/tsukuroi's run_tests.kotoba:

    * `load-file` fails here even given a correct path, because the
      Compiler enables #?(...) from the FILENAME and only for .cljc.
      A .kotoba source carrying reader conditionals is a hard
      `Conditional read not allowed`. Hence the explicit
      {:read-cond :allow}.
    * *file* is bound to the absolute path while evaluating, or every
      stack frame in a failing test names the wrong file.

  It reads .kotoba, .cljc and .clj alike, so it keeps working
  whichever way the migration goes next.

  ## The floor

  Discovery, load and execution each report a count, and zero is never
  clean. The floor is not merely 'more than zero' but 'not less than
  the README publishes' -- the weaker form would have been satisfied
  by a single surviving test after the other thirteen were lost.
  A README that stops publishing a count, or publishes zero, is itself
  a refusal: a floor that silently becomes zero is not a floor.

  Exit codes are three-valued, because 'the tests failed' and 'the
  tests could not be run' are different answers and must not share
  one:

      0  ran, met the published floor, every assertion passed
      1  ran, and something failed or errored
      2  REFUSED -- could not answer (nothing found, nothing ran,
         fewer than published, or a source would not read)"
  (:require [clojure.java.io :as io]
            [clojure.string :as str]
            [clojure.test :as test])
  (:import [clojure.lang LineNumberingPushbackReader]
           [java.io File]))

(def source-ext #{"kotoba" "cljc" "clj"})
(def internal-prefix "netops.")
(def read-opts {:read-cond :allow :features #{:clj} :eof ::eof})

(defn ext-of [^String n]
  (let [i (.lastIndexOf n ".")] (when (pos? i) (subs n (inc i)))))

(defn sources-under [root dir]
  (let [d (io/file root dir)]
    (when (.isDirectory d)
      (->> (file-seq d)
           (filter #(.isFile ^File %))
           (filter #(source-ext (ext-of (.getName ^File %))))
           (sort-by #(.getPath ^File %))))))

(defn forms-of
  "Every top-level form in `f`, reader conditionals resolved for :clj.
  Throws if the source will not read -- a source that cannot be read
  is a refusal, never a skip."
  [^File f]
  (with-open [r (LineNumberingPushbackReader. (io/reader f))]
    (doall (take-while #(not= ::eof %) (repeatedly #(read read-opts r))))))

(defn internal-requires [ns-form]
  (->> ns-form
       (drop 2)
       (filter #(and (seq? %) (= :require (first %))))
       (mapcat rest)
       (map #(if (vector? %) (first %) %))
       (filter symbol?)
       (filter #(str/starts-with? (str %) internal-prefix))
       set))

(defn describe
  "{:file :abs :ns :requires :forms} for every source whose first form
  declares a namespace. This runner excludes itself."
  [root]
  (->> (concat (sources-under root "src") (sources-under root "test"))
       (keep (fn [^File f]
               (let [forms (forms-of f)
                     nm    (second (first forms))]
                 (when (and (seq? (first forms))
                            (= 'ns (ffirst forms))
                            (symbol? nm)
                            (not= nm 'netops.run-tests))
                   {:file (.getPath f) :abs (.getAbsolutePath f) :ns nm
                    :requires (internal-requires (first forms)) :forms forms}))))
       vec))

(defn mark-loaded! [n]
  (dosync (commute @#'clojure.core/*loaded-libs* conj n)))

(defn load-all!
  "Eval every source in dependency order, registering each namespace as
  loaded so the next file's :require resolves to it rather than
  hunting the classpath for a file extension that is not there."
  [sources]
  (loop [pending (vec sources) loaded #{}]
    (if (empty? pending)
      loaded
      (let [ready   (filterv #(every? loaded (:requires %)) pending)
            blocked (filterv #(not (every? loaded (:requires %))) pending)]
        (when (empty? ready)
          (throw (ex-info "unresolvable require order among sources"
                          {:pending (mapv (juxt :ns :requires) pending)})))
        (doseq [{:keys [ns forms abs file]} ready]
          (binding [*ns* *ns*, *file* abs, *source-path* file]
            (doseq [f forms] (eval f)))
          (mark-loaded! ns))
        (recur blocked (into loaded (map :ns ready)))))))

(defn published-floor
  "The counts README.md publishes, as {:tests n :assertions n}, or nil
  if it publishes none."
  [root]
  (let [f (io/file root "README.md")]
    (when (.isFile f)
      (when-let [[_ t a] (re-find #"(\d+)\s+tests?\s*/\s*(\d+)\s+assertions"
                                  (slurp f))]
        {:tests (parse-long t) :assertions (parse-long a)}))))

(defn refuse! [msg]
  (println (str "  REFUSING TO REPORT A PASS: " msg))
  (flush)
  (System/exit 2))

(defn main! [args]
  (let [evidence? (some #{"--evidence"} args)
        root      (or (System/getProperty "netops.root") ".")
        sources   (try (describe root)
                       (catch Exception e
                         (refuse! (str "a source would not read -- " (.getMessage e)))))
        test-nss  (->> sources (map :ns)
                       (filter #(str/ends-with? (str %) "-test")) sort vec)
        floor     (published-floor root)]
    (println (format "  discovered: %d source(s), %d test namespace(s) under %s"
                     (count sources) (count test-nss) root))
    (println (format "  published floor (README.md): %s"
                     (if floor
                       (format "%d tests / %d assertions" (:tests floor) (:assertions floor))
                       "NONE")))
    (when evidence?
      (doseq [s sources] (println "   " (:ns s) "<-" (:file s)))
      (System/exit 0))

    ;; Floor 0 -- the floor itself. A floor that silently becomes zero
    ;; is not a floor, so its absence refuses rather than passes.
    (when-not floor
      (refuse! (str "README.md publishes no '<n> tests / <m> assertions' count. "
                    "Without it this runner cannot tell a complete run from a "
                    "truncated one.")))
    (when (or (zero? (:tests floor)) (zero? (:assertions floor)))
      (refuse! (format "README.md publishes a zero floor (%d tests / %d assertions)"
                       (:tests floor) (:assertions floor))))

    ;; Floor 1 -- discovery. An empty tree must not look like a clean one.
    (when (zero? (count sources))
      (refuse! (str "no sources found under " root "/{src,test} with extensions "
                    (pr-str (sort source-ext)))))
    (when (zero? (count test-nss))
      (refuse! "no test namespaces found -- a suite with no tests is not a passing suite"))

    (try (load-all! sources)
         (catch Exception e
           (refuse! (str "sources would not load -- " (.getMessage e)))))

    (let [{:keys [test pass fail error]} (apply test/run-tests test-nss)
          tests      (or test 0)
          assertions (+ (or pass 0) (or fail 0) (or error 0))]
      ;; Floor 2 -- execution. Loading is not running.
      (when (zero? tests)
        (refuse! (format "%d test namespace(s) loaded but 0 tests ran" (count test-nss))))
      ;; Floor 3 -- the published count. Not 'more than zero': not less
      ;; than what this repository tells the world it runs.
      (when (or (< tests (:tests floor)) (< assertions (:assertions floor)))
        (refuse! (format (str "ran %d tests / %d assertions, below the %d / %d "
                              "README.md publishes. Either tests were lost, or "
                              "the README is stale -- both need a human.")
                         tests assertions (:tests floor) (:assertions floor))))
      (if (pos? (+ (or fail 0) (or error 0)))
        (do (println (format "  netops: FAILED -- %d failure(s), %d error(s) over %d test(s)"
                             fail error tests))
            (flush)
            (System/exit 1))
        (do (println (format "  netops: OK -- %d tests / %d assertions / %d namespaces (floor %d / %d)"
                             tests assertions (count test-nss)
                             (:tests floor) (:assertions floor)))
            (flush)
            (System/exit 0))))))

(main! *command-line-args*)

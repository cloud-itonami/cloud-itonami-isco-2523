(ns netops.governor-test
  (:require [clojure.test :refer [deftest is testing]]
            [netops.store :as store]
            [netops.governor :as governor]))

(defn- fresh-store []
  (let [st (store/mem-store)]
    (store/register-client! st {:client-id "client-1" :name "Kobo Trade"})
    (doseq [z ["dmz" "lan" "db" "mgmt"]]
      (store/register-zone! st {:zone-id z :client-id "client-1" :name z}))
    st))

(defn- add-rule [rule]
  {:op :add-rule :effect :propose :rule rule
   :confidence 0.9 :stake :low})

(def ^:private req {:client-id "client-1"})

(deftest ok-non-shadowed-rule
  (let [st (fresh-store)
        v (governor/check req {} (add-rule {:action :allow
                                            :src-zones #{"lan"}
                                            :dst-zones #{"db"}}) st)]
    (is (:ok? v))))

(deftest ok-when-existing-rule-is-narrower
  (testing "an earlier narrower rule does not shadow a broader addition"
    (let [st (fresh-store)]
      (store/register-rule! st {:rule-id "R-1" :client-id "client-1" :order 1
                                :action :allow :src-zones #{"lan"}
                                :dst-zones #{"db"}})
      (let [v (governor/check req {} (add-rule {:action :allow
                                                :src-zones #{"lan" "dmz"}
                                                :dst-zones #{"db"}}) st)]
        (is (:ok? v))))))

(deftest hard-on-redundant-shadow
  (testing "same action + containing match sets = redundant dead config"
    (let [st (fresh-store)]
      (store/register-rule! st {:rule-id "R-1" :client-id "client-1" :order 1
                                :action :allow :src-zones #{"lan" "dmz"}
                                :dst-zones #{"db" "mgmt"}})
      (let [v (governor/check req {} (assoc (add-rule {:action :allow
                                                       :src-zones #{"lan"}
                                                       :dst-zones #{"db"}})
                                            :confidence 0.99) st)]
        (is (:hard? v))
        (is (some #(= :shadowed-rule (:rule %)) (:violations v)))))))

(deftest hard-on-contradicting-shadow
  (testing "different action + containing match sets = the earlier rule always wins"
    (let [st (fresh-store)]
      (store/register-rule! st {:rule-id "R-1" :client-id "client-1" :order 1
                                :action :deny :src-zones #{"lan" "dmz"}
                                :dst-zones #{"db"}})
      (let [v (governor/check req {} (add-rule {:action :allow
                                                :src-zones #{"lan"}
                                                :dst-zones #{"db"}}) st)]
        (is (:hard? v))
        (is (some #(= :shadowed-rule (:rule %)) (:violations v)))))))

(deftest hard-on-unknown-zone
  (let [st (fresh-store)
        v (governor/check req {} (add-rule {:action :allow
                                            :src-zones #{"lan" "ghost"}
                                            :dst-zones #{"db"}}) st)]
    (is (:hard? v))
    (is (some #(= :unknown-zone (:rule %)) (:violations v)))))

(deftest hard-on-foreign-zone
  (let [st (fresh-store)]
    (store/register-client! st {:client-id "client-2" :name "Other"})
    (store/register-zone! st {:zone-id "other-lan" :client-id "client-2"
                              :name "other-lan"})
    (let [v (governor/check req {} (add-rule {:action :allow
                                              :src-zones #{"other-lan"}
                                              :dst-zones #{"db"}}) st)]
      (is (:hard? v))
      (is (some #(= :zone-wrong-client (:rule %)) (:violations v))))))

(deftest hard-on-missing-rule-body
  (let [st (fresh-store)
        v (governor/check req {} {:op :add-rule :effect :propose
                                  :confidence 0.9 :stake :low} st)]
    (is (:hard? v))
    (is (some #(= :no-rule (:rule %)) (:violations v)))))

(deftest hard-on-unregistered-client
  (let [st (fresh-store)
        v (governor/check {:client-id "nobody"} {}
                          (add-rule {:action :allow :src-zones #{"lan"}
                                     :dst-zones #{"db"}}) st)]
    (is (:hard? v))
    (is (some #(= :no-client (:rule %)) (:violations v)))))

(deftest hard-on-no-actuation-violation
  (let [st (fresh-store)
        v (governor/check req {} (assoc (add-rule {:action :allow
                                                   :src-zones #{"lan"}
                                                   :dst-zones #{"db"}})
                                        :effect :direct-write) st)]
    (is (:hard? v))
    (is (some #(= :no-actuation (:rule %)) (:violations v)))))

(deftest escalates-production-apply
  (let [st (fresh-store)
        v (governor/check req {} {:op :apply-to-production :effect :propose
                                  :confidence 0.9 :stake :high} st)]
    (is (not (:hard? v)))
    (is (:escalate? v))))

(deftest escalates-low-confidence
  (let [st (fresh-store)
        v (governor/check req {} (assoc (add-rule {:action :allow
                                                   :src-zones #{"lan"}
                                                   :dst-zones #{"db"}})
                                        :confidence 0.3) st)]
    (is (not (:hard? v)))
    (is (:escalate? v))))

;; ── the invariants bind to the rule body, not to one operation ──────────
;;
;; Until 2026-09-11 every check below sat behind `(= :add-rule op)`, so the
;; same rule body under any other operation was never read. These tests fail
;; against that governor; that is the point of them. The bodies here are
;; deliberately identical to the ones the :add-rule tests above use, so the
;; only variable is the operation name.

(defn- carrying [op rule]
  {:op op :effect :propose :rule rule :confidence 0.9 :stake :low})

(def ^:private rule-carrying-ops [:add-rule :draft-change :apply-to-production])

(deftest hard-on-undeclared-operation
  (testing "the operation vocabulary is a closed allowlist, not a denylist"
    (let [st (fresh-store)
          v (governor/check req {} (carrying :delete-every-rule
                                             {:action :allow
                                              :src-zones #{"lan"}
                                              :dst-zones #{"db"}}) st)]
      (is (:hard? v))
      (is (some #(= :unsupported-operation (:rule %)) (:violations v))))))

(deftest undeclared-operations-answer-false-everywhere
  (is (not (governor/supported? :delete-every-rule)))
  (is (not (governor/supported? :unknown)))
  (is (not (governor/supported? nil)))
  (doseq [op rule-carrying-ops]
    (is (governor/supported? op) (str op " must be declared"))))

(deftest an-unparseable-advisor-proposal-holds
  (testing "netops.advisor emits :op :unknown when it cannot parse the LLM
            reply; that must hold, not merely escalate on low confidence"
    (let [st (fresh-store)
          v (governor/check req {} {:op :unknown :effect :propose
                                    :confidence 0.0 :stake :high} st)]
      (is (:hard? v))
      (is (some #(= :unsupported-operation (:rule %)) (:violations v))))))

(deftest zone-basis-applies-to-every-operation-carrying-a-rule
  (doseq [op rule-carrying-ops]
    (testing (str "invented zone under " op)
      (let [st (fresh-store)
            v (governor/check req {} (carrying op {:action :allow
                                                   :src-zones #{"lan" "ghost"}
                                                   :dst-zones #{"db"}}) st)]
        (is (:hard? v) (str op " must refuse an invented zone"))
        (is (some #(= :unknown-zone (:rule %)) (:violations v)))))))

(deftest foreign-zone-refused-under-every-operation-carrying-a-rule
  (doseq [op rule-carrying-ops]
    (testing (str "another client's zone under " op)
      (let [st (fresh-store)]
        (store/register-client! st {:client-id "client-2" :name "Other"})
        (store/register-zone! st {:zone-id "other-lan" :client-id "client-2"
                                  :name "other-lan"})
        (let [v (governor/check req {} (carrying op {:action :allow
                                                     :src-zones #{"other-lan"}
                                                     :dst-zones #{"db"}}) st)]
          (is (:hard? v) (str op " must refuse a foreign zone"))
          (is (some #(= :zone-wrong-client (:rule %)) (:violations v))))))))

(deftest shadow-detection-applies-to-every-operation-carrying-a-rule
  (doseq [op rule-carrying-ops]
    (testing (str "dead config under " op)
      (let [st (fresh-store)]
        (store/register-rule! st {:rule-id "R-1" :client-id "client-1" :order 1
                                  :action :deny :src-zones #{"lan" "dmz"}
                                  :dst-zones #{"db"}})
        (let [v (governor/check req {} (carrying op {:action :allow
                                                     :src-zones #{"lan"}
                                                     :dst-zones #{"db"}}) st)]
          (is (:hard? v) (str op " must refuse config an earlier rule covers"))
          (is (some #(= :shadowed-rule (:rule %)) (:violations v))))))))

(deftest production-apply-with-an-invented-zone-holds-rather-than-escalating
  (testing "the worst of the four: stopping and giving a reason are different
            acts. A live network change citing a zone that does not exist
            reached human sign-off as {:escalate? true :violations []}."
    (let [st (fresh-store)
          v (governor/check req {} (carrying :apply-to-production
                                             {:action :allow
                                              :src-zones #{"ghost"}
                                              :dst-zones #{"db"}}) st)]
      (is (:hard? v) "must hold, not escalate")
      (is (not (:escalate? v)) "a held proposal is not an escalated one")
      (is (seq (:violations v)) "and it must arrive with its reason attached"))))

(deftest hard-on-empty-rule-basis
  (testing "a rule naming no zone on either side matches nothing --
            dead by construction, and with no active rules there is no
            containment to catch it"
    (let [st (fresh-store)
          v (governor/check req {} (carrying :add-rule {:action :allow
                                                        :src-zones #{}
                                                        :dst-zones #{}}) st)]
      (is (:hard? v))
      (is (some #(= :empty-rule-basis (:rule %)) (:violations v))))))

(deftest draft-change-requires-a-rule-body
  (let [st (fresh-store)
        v (governor/check req {} {:op :draft-change :effect :propose
                                  :confidence 0.9 :stake :low} st)]
    (is (:hard? v))
    (is (some #(= :no-rule (:rule %)) (:violations v)))))

(deftest a-clean-rule-still-passes-under-every-operation
  (testing "the refusals above are not a blanket deny"
    (doseq [op [:add-rule :draft-change]]
      (let [st (fresh-store)
            v (governor/check req {} (carrying op {:action :allow
                                                   :src-zones #{"lan"}
                                                   :dst-zones #{"db"}}) st)]
        (is (:ok? v) (str op " with a clean rule must pass"))
        (is (empty? (:violations v)))))
    (let [st (fresh-store)
          v (governor/check req {} (carrying :apply-to-production
                                             {:action :allow
                                              :src-zones #{"lan"}
                                              :dst-zones #{"db"}}) st)]
      (is (not (:hard? v)) "a clean production apply is not held")
      (is (:escalate? v) "but it still needs a human"))))
